{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ImperialCollegeLondon/lbf-data-tools/tree/main/profiles/bronze/0.4.0",
  "title": "Bronze dataset",
  "description": "A dataset as landed: at least one file, and a crate recording its identifier, who uploaded it, when, and the profiles it conforms to. Every dataset meets this profile; others build on it with $ref.",
  "type": "object",
  "required": ["data", "crate"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["name", "files"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "crate": {
      "type": "object",
      "required": ["identifier", "creator", "datePublished", "conformsTo", "additionalProperty"],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^[0-9]{8}-[a-z]+-[a-z]+-[a-f0-9]{4}$"
        },
        "creator": { "type": "string", "minLength": 1 },
        "datePublished": { "type": "string", "format": "date-time" },
        "conformsTo": {
          "type": "array",
          "contains": { "const": "https://github.com/ImperialCollegeLondon/lbf-data-tools/tree/main/profiles/bronze/0.4.0" }
        },
        "additionalProperty": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
